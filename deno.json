{
  "workspace": [
    "./instruments/signal-generator",
    "./instruments/oscilloscope",
    "./instruments/multimeter"
  ],
  "tasks": {
    "dev": "deno run --watch --allow-all main.ts",
    "start": "deno run --allow-all main.ts",
    "mcp": "deno run --allow-net=127.0.0.1:8000 src/mcp_cli.ts",
    "test": "deno test --allow-all",
    "test:instruments": "deno run --allow-all scripts/check_instruments.ts"
  },
  "vendor": true,
  "fmt": {
    "exclude": ["**/vendor/**"]
  },
  "lint": {
    "exclude": ["**/vendor/**"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  }
}
