{
  "tasks": {
    "dev": "deno run --watch --allow-all main.ts",
    "start": "deno run --allow-all main.ts",
    "plugin": "deno run --cached-only --no-prompt --allow-read=. --allow-net=127.0.0.1 plugin.ts --port 8001",
    "cli": "deno run --allow-all src/cli.ts",
    "test": "deno test --allow-all"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/http/file-server": "jsr:@std/http@^1.0.0/file-server"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  }
}
